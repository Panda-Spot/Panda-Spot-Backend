generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Null for Google-only accounts (no password was ever set) — see routes/auth.js's
  /// /auth/google handler and the login route's null-check.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())
  events       Event[]

  /// Studio-wide branding, applied to every guest page across all of this
  /// photographer's events (not per-event — see server/README.md's branding notes).
  studioName String?
  logoPath   String?
  brandColor String?

  collaboratesOn EventCollaborator[]

  /// Google account id (the JWT `sub` claim) once linked via Sign in with
  /// Google — null for accounts that have never used it.
  googleId String? @unique

  /// Null until the user clicks their emailed verification link. Verification
  /// is soft/non-blocking (see routes/auth.js) — this only drives a UI nudge,
  /// it never gates login or feature access.
  emailVerifiedAt DateTime?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

/// A single-use, time-limited token emailed to confirm account ownership.
/// Non-blocking (see User.emailVerifiedAt) — purely a soft nudge.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

/// A single-use, time-limited token emailed to let a user set a new password
/// without knowing their old one. See routes/auth.js's /auth/password-reset/*.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Event {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  guestSlug String   @unique
  createdAt DateTime @default(now())
  photos    Photo[]

  /// Per-event override of the global FACE_MATCH_THRESHOLD env default —
  /// null until a guest's "not me" feedback nudges it. See lib/threshold.js.
  matchThreshold Float?

  /// Stamped at creation as createdAt + 90 days. Once past, guest-facing
  /// routes (search/download/feedback) soft-close with a 410 — the
  /// photographer keeps full access regardless; nothing is deleted.
  /// See lib/expiry.js.
  expiresAt DateTime

  guestSearches GuestSearch[]
  zipDownloads  ZipDownload[]
  collaborators EventCollaborator[]
  invites       EventInvite[]
  alertSubscriptions GuestAlertSubscription[]

  /// Google Drive folder connected for this event's photo sync — set once
  /// the photographer confirms the initial import. See lib/driveSync.js.
  /// Null until connected.
  driveFolderId  String?
  driveFolderUrl String?
  /// Off by default; set true once connected. When true, the daily
  /// scheduler (lib/driveSync.js's runDueAutoSyncs) diffs the folder and
  /// imports new / removes deleted photos automatically, on top of the
  /// manual "Sync now" button which works regardless of this flag.
  driveSyncEnabled Boolean   @default(false)
  lastDriveSyncAt  DateTime?

  /// Per-event FTP credentials for camera-to-cloud live upload ("Beam") —
  /// null until the photographer generates them from the event page. Stored
  /// as plaintext (not hashed) because, unlike a login password, the
  /// photographer needs to read it back to type into their camera's FTP
  /// menu — it's a scoped upload-only token, not an account credential, and
  /// can be regenerated any time. See lib/ftpBeam.js.
  ftpUsername String? @unique
  ftpPassword String?

  /// Advanced/beta: when true, each Beam capture is uploaded into this
  /// event's connected driveFolderId using the platform's own single Drive
  /// account (see lib/driveBackupAuth.js — GOOGLE_DRIVE_BACKUP_REFRESH_TOKEN,
  /// not a per-photographer grant), instead of also keeping the full-res
  /// original on the VPS. Independent of driveSyncEnabled, which controls
  /// the opposite direction (Drive -> PandaSpot). See lib/driveBackup.js and
  /// lib/driveBackupRetention.js for the reclaim/purge lifecycle this
  /// implies — the platform's own Drive storage is a temporary relay, not a
  /// permanent archive, so photos backed up this way are deleted (from both
  /// Drive and the VPS) 7 days after capture unless the studio owner has
  /// made their own copy in Drive by then.
  driveBackupEnabled Boolean @default(false)
  /// Stamped on every Beam capture (regardless of driveBackupEnabled) —
  /// used to infer "this shoot looks finished" (no captures for a while) so
  /// the reclaim notice email (see lib/driveBackupRetention.js) fires once,
  /// promptly, instead of only after the unrelated 90-day guest-expiry.
  lastBeamCaptureAt DateTime?
  /// Set once the "make your own copy — you have 7 days" notice has been
  /// sent for this event, so it's never sent twice.
  driveBackupNoticeSentAt DateTime?
}

/// A second shooter/assistant granted upload+view access to one event without
/// sharing the owner's login. Only the owner can manage collaborators/branding;
/// collaborators can view the event, upload photos, and see its analytics.
/// See lib/access.js for the owner-or-collaborator authorization helper.
model EventCollaborator {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

/// A pending collaborator invite sent to an email address that may not have
/// a PandaSpot account yet. Accepted (see routes/invites.js) either right
/// away if the account already existed, or once the invitee registers/logs
/// in via the invite link — at which point an EventCollaborator row is
/// created and acceptedAt is stamped.
model EventInvite {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  email      String
  token      String    @unique
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([eventId])
  @@index([email])
}

model Photo {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  filename    String
  /// Null for Google Drive imports — the original is never written to local
  /// disk for those (see lib/googleDrive.js); full-res access falls back to
  /// driveFileId instead. Always set for directly-uploaded photos.
  storagePath String?
  /// Resized preview (~480px) generated at upload time for fast gallery
  /// grids — null if generation failed, in which case callers fall back
  /// to the full-size original. See lib/thumbnails.js.
  thumbnailPath String?
  /// Set only for Google Drive imports — the Drive file ID, used to
  /// re-fetch the original on demand (download/share) since it's never
  /// stored locally. Null for directly-uploaded photos.
  driveFileId String?
  /// Original file size in bytes — used to enforce the free-tier per-event
  /// storage cap (see lib/planLimits.js), populated from Drive's reported
  /// size for imports even though those bytes are never retained locally.
  fileSize    Int      @default(0)
  faceCount   Int      @default(0)
  createdAt   DateTime @default(now())
  faces       Face[]

  /// True only for a Beam capture uploaded to Drive via the platform's own
  /// account (Event.driveBackupEnabled) — distinguishes it from a Google
  /// Drive *import* (photographer's own pre-existing Drive content, driveFileId
  /// also set but never auto-deleted) and from a normal direct upload. Drives
  /// lib/driveBackupRetention.js's 2-day-reclaim / 7-day-purge sweep, which
  /// only ever touches rows with this flag true.
  platformDriveBackup Boolean @default(false)
}

/// Face rows are inserted/queried via raw SQL because the `embedding` column
/// is an Unsupported pgvector type that Prisma Client cannot bind directly.
/// See lib/faces.js for the raw INSERT / SELECT helpers. The migration also
/// creates an HNSW index on `embedding` (Prisma's schema DSL can't express
/// pgvector index types itself, so it's hand-written SQL, not declared here).
model Face {
  id        String                  @id @default(uuid())
  photoId   String
  photo     Photo                   @relation(fields: [photoId], references: [id])
  eventId   String
  bbox      Json
  embedding Unsupported("vector(512)")
  detScore  Float
  createdAt DateTime                @default(now())

  @@index([eventId])
}

/// One row per guest selfie search — stores the (averaged, if multi-selfie)
/// query embedding so a later "not me" feedback report can be tied back to
/// it, and doubles as the analytics source (search counts, unique guests via
/// guestClientId, match rate). See lib/guestSearches.js for the raw
/// INSERT (embedding is Unsupported, same reason as Face.embedding).
model GuestSearch {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  embedding     Unsupported("vector(512)")
  facesDetected Int
  matchCount    Int
  guestClientId String?
  createdAt     DateTime @default(now())

  feedback MatchFeedback[]

  @@index([eventId])
}

/// A guest marking one match as "not me". Used to auto-nudge Event.matchThreshold
/// upward (see lib/threshold.js) and as an analytics signal.
model MatchFeedback {
  id         String      @id @default(uuid())
  searchId   String
  search     GuestSearch @relation(fields: [searchId], references: [id])
  photoId    String
  similarity Float
  createdAt  DateTime    @default(now())

  @@index([searchId])
}

/// A pre-built zip, generated asynchronously and emailed to a guest as a
/// download link instead of blocking their browser tab on a large selection.
/// A guest opting in to be notified (email or WhatsApp) if more photos of
/// them show up later in the same event — the natural follow-up once photos
/// can keep arriving live via Beam after their first search. One row per
/// (event, guestClientId): a guest who searches again just updates their
/// existing subscription rather than creating a second one. See
/// lib/guestAlerts.js for the matching/notify job.
model GuestAlertSubscription {
  id             String    @id @default(uuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  guestClientId  String
  /// "email" | "whatsapp"
  channel        String
  /// An email address or E.164 phone number, depending on channel.
  contact        String
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?
  active         Boolean   @default(true)

  @@unique([eventId, guestClientId])
  @@index([eventId])
}

model ZipDownload {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  photoIds     Json
  email        String?
  status       String    @default("pending") // pending | ready | failed
  filePath     String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  readyAt      DateTime?

  @@index([eventId])
}
