generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 4-tier role model, added for the Studio-Verse merge (see MERGE_PLAN.md
/// D2). Every row that existed before this migration is backfilled as
/// ADMIN (a studio owner) — that's exactly what every pre-merge PandaSpot
/// account already was. SUPER_ADMIN is the platform operator. Production
/// super-admin login is env-backed via SUPER_ADMIN_EMAIL/PASSWORD, so it
/// does not require a User row. USER is a studio's client (Photo Selection
/// login). INVITED generalizes the old EventCollaborator/EventInvite
/// bolt-on into a first-class scoped-access role.
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  INVITED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// MERGE: added for the Studio-Verse merge — see the Role enum's own
  /// comment. Defaults ADMIN so every existing account keeps working
  /// exactly as before (a studio owner) without any other backfill.
  role         Role     @default(ADMIN)
  /// Null for Google-only accounts (no password was ever set) — see routes/auth.js's
  /// /auth/google handler and the login route's null-check.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())
  events       Event[]

  /// Studio-wide branding, applied to every guest page across all of this
  /// photographer's events (not per-event — see server/README.md's branding notes).
  studioName String?
  logoPath   String?
  /// Optional watermark overlay image (mirrors Studio-Verse's watermark
  /// upload) — shown centered over protected client-gallery photos when
  /// set, falling back to the studio-name text watermark otherwise.
  /// Stored beside the logo; served publicly like it.
  watermarkImagePath String?
  brandColor String?
  watermarkIntensity Float @default(0.75)

  collaboratesOn EventCollaborator[]

  /// MERGE (Studio-Verse Photo Selection): events this USER-role client
  /// has been granted gallery access to, and the favourites/picks they've
  /// made.
  eventAccess       EventUserMapping[]
  clientFavourites  ClientFavourite[]
  studioFavourites  StudioFavourite[]
  /// Album proofing authorship (pins + replies, Phase 23).
  albumComments     AlbumComment[]
  /// Album projects created by this user (Phase 4 audit).
  albumsCreated     Album[]

  /// MERGE (Studio-Verse Billing & Subscriptions): this ADMIN-role user
  /// acting as the studio ("tenant" in Studio-Verse's terms — this merge
  /// has no separate Tenant table, an ADMIN User IS the tenant).
  subscriptions      TenantSubscription[]
  wallet             TenantWallet?
  walletTransactions WalletTransaction[]
  billingSettings    TenantBillingSettings?
  /// MERGE (Studio-Verse tenant profile, Phase 18H): contact/address
  /// details, lazily created on first profile read/write.
  tenantProfile      TenantProfile?
  studioServices     StudioService[]
  quotationsAsTenant Quotation[]            @relation("QuotationTenant")
  billsAsTenant      Bill[]                 @relation("BillTenant")
  paymentsAsTenant   Payment[]              @relation("PaymentTenant")
  /// A USER-role client being billed — see resolveClient's own comment on
  /// Quotation/Bill below for why this is just the same User model,
  /// unlike Studio-Verse's separate legacy BillingClient table.
  quotationsAsClient Quotation[]            @relation("QuotationClient")
  billsAsClient      Bill[]                 @relation("BillClient")

  /// MERGE (Studio-Verse Support Tickets, Phase 13).
  supportTicketsAsTenant   SupportTicket[]      @relation("SupportTicketTenant")
  requestedSupportTickets  SupportTicket[]      @relation("SupportTicketRequester")
  supportTicketReplies     SupportTicketReply[]

  /// Google account id (the JWT `sub` claim) once linked via Sign in with
  /// Google — null for accounts that have never used it.
  googleId String? @unique

  /// Null until the user clicks their emailed verification link. Verification
  /// is soft/non-blocking (see routes/auth.js) — this only drives a UI nudge,
  /// it never gates login or feature access.
  emailVerifiedAt DateTime?

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  /// Set by a platform admin (see routes/admin.js) to lock an account out —
  /// checked by both requireAuth (every authenticated request, not just at
  /// login) and /auth/login|/auth/google, so it takes effect immediately
  /// rather than only on the account's next fresh login.
  suspendedAt DateTime?

  /// Per-client admin overrides of the global free-tier defaults
  /// (lib/planLimits.js's FREE_EVENT_LIMIT/FREE_EVENT_STORAGE_BYTES) — null
  /// means "use the default". customStorageLimitBytes is BigInt (not Int):
  /// a generous override (e.g. 100GB) overflows Postgres's 32-bit integer.
  customEventLimit        Int?
  customStorageLimitBytes BigInt?
  /// Admin override of DEFAULT_PHOTO_RETENTION_DAYS (lib/planLimits.js) —
  /// how many days this client's photo originals stay on the server before
  /// lib/photoRetention.js deletes just the full-res file (thumbnail +
  /// search data are never touched by this). Null means "use the default".
  customPhotoRetentionDays Int?

  /// MERGE (Studio-Verse): account-lockout counters for the login route.
  /// failedLoginAttempts resets to 0 on any successful login; lockedUntil
  /// is set once attempts hit ACCOUNT_LOCK_MAX_FAILED_ATTEMPTS and blocks
  /// login (with a clear message) until it passes, then the next attempt
  /// is allowed to try again fresh. Independent of suspendedAt (an admin
  /// action) — this is purely a self-triggered, self-clearing brute-force
  /// defense.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
}

/// MERGE (Studio-Verse): a specific JWT (by its `jti` claim), blocked
/// before its natural expiry — powers real logout (a Bearer token can't
/// otherwise be invalidated early) and "log out everywhere" after a
/// password reset. expiresAt mirrors the token's own `exp` so a cleanup
/// job can safely delete rows for tokens that would have expired anyway.
/// See middleware/auth.js's requireAuth, which checks this table on every
/// authenticated request.
model TokenBlocklist {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// A single-use, time-limited token emailed to confirm account ownership.
/// Non-blocking (see User.emailVerifiedAt) — purely a soft nudge.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

/// A single-use, time-limited token emailed to let a user set a new password
/// without knowing their old one. See routes/auth.js's /auth/password-reset/*.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Event {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  guestSlug String   @unique
  createdAt DateTime @default(now())
  photos    Photo[]

  /// Per-event override of the global FACE_MATCH_THRESHOLD env default —
  /// null until a guest's "not me" feedback nudges it. See lib/threshold.js.
  matchThreshold Float?

  /// Stamped at creation as createdAt + 90 days. Once past, guest-facing
  /// routes (search/download/feedback) soft-close with a 410 — the
  /// photographer keeps full access regardless; nothing is deleted.
  /// See lib/expiry.js.
  expiresAt DateTime

  guestSearches GuestSearch[]
  zipDownloads  ZipDownload[]
  collaborators EventCollaborator[]
  invites       EventInvite[]
  alertSubscriptions GuestAlertSubscription[]

  /// MERGE (Studio-Verse): independent feature toggles so an event can run
  /// Face Search and/or Photo Selection at the same time — see
  /// MERGE_PLAN.md D6. faceSearchEnabled defaults true because every
  /// event created before this migration IS a face-search event today;
  /// photoSelectionEnabled defaults false since it's a brand-new
  /// capability nothing existing opted into yet.
  faceSearchEnabled     Boolean @default(true)
  photoSelectionEnabled Boolean @default(false)

  /// MERGE (Studio-Verse): studio can unpublish/republish an event
  /// independent of guest-access expiry (expiresAt) — while unpublished,
  /// Photo Selection clients see a "not ready yet" state. Null = never
  /// published (new default for events created after this migration);
  /// existing events are backfilled to their own createdAt, since they've
  /// effectively been "published" (live to guests) since creation.
  publishedAt DateTime?
  /// MERGE (Studio-Verse): per-event opt-out of allowing clients/guests to
  /// download full-resolution originals (view/favourite only). Defaults
  /// true (download allowed) to match PandaSpot's existing behavior for
  /// every event that predates this flag.
  allowDownload Boolean @default(true)

  /// Phase 2 (consent-first Face Search): when true, selfie search is
  /// blocked until the guest ticks the consent checkbox — every search
  /// then logs a GuestConsent row. Defaults false so every existing
  /// event keeps working exactly as before.
  requireFaceSearchConsent Boolean @default(false)
  /// Studio-editable privacy notice shown on the guest search page.
  /// Null = the built-in default text (see lib/facePrivacy.js).
  privacyNoticeText String?
  /// How uploaded selfies are treated. Selfies arrive via in-memory
  /// upload and are never written to disk either way; "process_only"
  /// (default) additionally means only the match runs and the buffer is
  /// zeroed right after, while "retain" records the studio's explicit
  /// opt-in to keep search records longer (audit marker for the future).
  selfieRetentionMode String @default("process_only")
  /// Days after which GuestSearch embedding rows auto-purge (hourly
  /// scheduler). Null = keep until the event is deleted.
  guestDataRetentionDays Int?
  /// Whether guests may file data-deletion requests from the event page.
  /// Export requests (their own data) are always allowed.
  allowGuestDataDeleteRequest Boolean @default(true)

  /// Phase 3 (gallery access upgrade): who the public guest link serves.
  /// "public" (anyone with the link, as today), "private_key" (needs the
  /// studio's access key → unlock token), "client_login" / "invite_only"
  /// (guest link closed — clients use their login instead).
  accessMode String @default("public")
  /// Phase 8 (live TV wall): "all" rotates every approved photo,
  /// "highlights" only studio-starred ones. Transition + QR visibility
  /// are per-event; sponsor branding overlays the wall when set.
  tvMode         String  @default("all")
  tvTransitionMs Int     @default(5000)
  tvShowQr       Boolean @default(true)
  sponsorName    String?
  sponsorLogoPath String?  /// bcrypt hash of the studio's private access key. Null = no key set —
  /// switching to private_key mode without one is rejected.
  accessKeyHash String?
  /// Which expiry preset the studio picked ("7_days" | "30_days" |
  /// "90_days" | "custom") — display/memory aid; expiresAt stays the
  /// enforcement source. Defaults to 90 to match computeExpiresAt.
  expiryPreset String @default("90_days")

  /// MERGE (Studio-Verse EventDetail depth, Phase 18E): soft archive — an
  /// archived event is hidden from guests (see lib/expiry.js, where
  /// archived counts as guest-closed) and from Photo Selection clients
  /// (see routes/client.js), while the studio keeps full access and can
  /// restore at any time. Null = active. Distinct from permanent deletion
  /// (lib/eventLifecycle.js), which is irreversible.
  archivedAt DateTime?
  /// Cover photo for the dashboard grid / client gallery header (16:9
  /// crop applied client-side before upload). Stored under the event's
  /// own directory so cascade-delete removes it with everything else.
  coverPhotoPath String?
  /// Optional display metadata edited from the event page (mirrors
  /// Studio-Verse's event edit fields). All nullable — older events
  /// simply show name-only until the studio fills these in.
  eventDate   DateTime?
  eventVenue  String?
  description String?

  /// MERGE (Studio-Verse Photo Selection): which USER-role clients have
  /// access to this event's gallery to browse/favourite/submit.
  clientAccess  EventUserMapping[]
  clientInvites ClientInvite[]
  /// MERGE (Studio-Verse resumable upload, Phase 18H): in-progress and
  /// finished chunked-upload trackers for this event.
  uploadStages  MediaUploadStage[]
  /// Album proofing projects (Phase 23).
  albums        Album[]
  supportTickets SupportTicket[]
  /// Consent-first Face Search (Phase 2 privacy): one row per guest
  /// consenting to a selfie search, and per-guest data requests.
  consents      GuestConsent[]
  dataRequests  GuestDataRequest[]

  /// Null until the owner clicks "Start Event" (see POST /events/:id/start)
  /// — a freshly-created event has no upload/import/PandaShoots UI at all
  /// until this is set, so there's never any ambiguity about when a
  /// photo's retention clock (Photo.originalExpiresAt) began. Existing
  /// events were grandfathered in as already-started at migration time.
  startedAt DateTime?

  /// Google Drive folder connected for this event's photo sync — set once
  /// the photographer confirms the initial import. See lib/driveSync.js.
  /// Null until connected.
  driveFolderId  String?
  driveFolderUrl String?
  /// Off by default; set true once connected. When true, the daily
  /// scheduler (lib/driveSync.js's runDueAutoSyncs) diffs the folder and
  /// imports new / removes deleted photos automatically, on top of the
  /// manual "Sync now" button which works regardless of this flag.
  driveSyncEnabled Boolean   @default(false)
  lastDriveSyncAt  DateTime?

  /// Per-event FTP credentials for camera-to-cloud live upload ("PandaShoots")
  /// — null until the photographer generates them from the event page.
  /// Stored as plaintext (not hashed) because, unlike a login password, the
  /// photographer needs to read it back to type into their camera's FTP
  /// menu — it's a scoped upload-only token, not an account credential, and
  /// can be regenerated any time. See lib/ftpShoots.js.
  ftpUsername String? @unique
  ftpPassword String?

  /// Advanced/beta: when true, each PandaShoots capture is uploaded into this
  /// event's connected driveFolderId using the platform's own single Drive
  /// account (see lib/driveBackupAuth.js — GOOGLE_DRIVE_BACKUP_REFRESH_TOKEN,
  /// not a per-photographer grant), instead of also keeping the full-res
  /// original on the VPS. Independent of driveSyncEnabled, which controls
  /// the opposite direction (Drive -> PandaSpot). See lib/driveBackup.js and
  /// lib/driveBackupRetention.js for the reclaim/purge lifecycle this
  /// implies — the platform's own Drive storage is a temporary relay, not a
  /// permanent archive, so photos backed up this way are deleted (from both
  /// Drive and the VPS) 7 days after capture unless the studio owner has
  /// made their own copy in Drive by then.
  driveBackupEnabled Boolean @default(false)
  /// Stamped on every PandaShoots capture (regardless of driveBackupEnabled)
  /// — used to infer "this shoot looks finished" (no captures for a while)
  /// so the reclaim notice email (see lib/driveBackupRetention.js) fires
  /// once, promptly, instead of only after the unrelated 90-day guest-expiry.
  lastShootsCaptureAt DateTime?
  /// Set once the "make your own copy — you have 7 days" notice has been
  /// sent for this event, so it's never sent twice.
  driveBackupNoticeSentAt DateTime?

  /// Opt-in toggle (owner/collaborator) for guests uploading their own
  /// photos back into this event via a dedicated upload link/QR, distinct
  /// from the search link. Off by default. Guest uploads always land as
  /// Photo.approvalStatus: "pending" and only become searchable/live once
  /// the owner approves them — see routes/guest.js's upload endpoint.
  guestUploadEnabled Boolean @default(false)
  /// Stamped whenever guestUploadEnabled is turned on — the anchor for
  /// guestUploadWindowDays below (not createdAt, since uploads might be
  /// turned on well after the event was created).
  guestUploadEnabledAt DateTime?
  /// Owner-set, per-event override for how many days guests can keep
  /// uploading after guestUploadEnabledAt — independent of the main
  /// 90-day guest-access window (expiresAt) that governs search/download.
  /// Null falls back to expiresAt, same as everyone else.
  guestUploadWindowDays Int?

  /// Self-relation for nested sub-galleries (e.g. "Ceremony"/"Reception"
  /// under one wedding) — a sub-gallery is a fully real Event of its own
  /// (own guestSlug, own photos, own everything), just not advertised with
  /// its own QR: guests reach it by picking it from the parent's guest
  /// page. Null for a top-level event or a sub-gallery's own children
  /// (one level of nesting only — enforced in routes/events.js, not here).
  parentEventId String?
  parent        Event?  @relation("EventSubGalleries", fields: [parentEventId], references: [id])
  subGalleries  Event[] @relation("EventSubGalleries")
}

/// A second shooter/assistant granted upload+view access to one event without
/// sharing the owner's login. Only the owner can manage collaborators/branding;
/// collaborators can view the event, upload photos, and see its analytics.
/// See lib/access.js for the owner-or-collaborator authorization helper.
model EventCollaborator {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

/// A pending collaborator invite sent to an email address that may not have
/// a PandaSpot account yet. Accepted (see routes/invites.js) either right
/// away if the account already existed, or once the invitee registers/logs
/// in via the invite link — at which point an EventCollaborator row is
/// created and acceptedAt is stamped.
model EventInvite {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  email      String
  token      String    @unique
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([eventId])
  @@index([email])
}

model Photo {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  filename    String
  /// Null for Google Drive imports — the original is never written to local
  /// disk for those (see lib/googleDrive.js); full-res access falls back to
  /// driveFileId instead. Always set for directly-uploaded photos.
  storagePath String?
  /// Resized preview (~480px) generated at upload time for fast gallery
  /// grids — null if generation failed, in which case callers fall back
  /// to the full-size original. See lib/thumbnails.js.
  thumbnailPath String?
  /// Set only for Google Drive imports — the Drive file ID, used to
  /// re-fetch the original on demand (download/share) since it's never
  /// stored locally. Null for directly-uploaded photos.
  driveFileId String?
  /// Original file size in bytes — used to enforce the free-tier per-event
  /// storage cap (see lib/planLimits.js), populated from Drive's reported
  /// size for imports even though those bytes are never retained locally.
  fileSize    Int      @default(0)
  faceCount   Int      @default(0)
  /// Set whenever this photo has been sent through face-engine for Face
  /// Search indexing, even if zero faces were found. Visibility can change
  /// later without losing the extraction/cost audit point.
  faceIndexedAt DateTime?
  createdAt   DateTime @default(now())
  faces       Face[]

  /// True for any photo backed up to Drive via the platform's own account
  /// (Event.driveBackupEnabled) — either a PandaShoots capture that went
  /// straight there, or an already-local photo (direct upload, or a
  /// PandaShoots capture from before backup was turned on) added via
  /// POST /events/:id/drive-backup/backup-existing. Distinguishes both from
  /// a Google Drive *import* (photographer's own pre-existing Drive
  /// content, driveFileId also set but never auto-deleted). Drives
  /// lib/driveBackupRetention.js's 2-day-reclaim / 7-day-purge sweep, which
  /// only ever touches rows with this flag true — deliberately including
  /// photos that already had a durable local copy before backup started
  /// (see that column's own comment on why storagePath alone isn't enough
  /// to know whether reclaim needs to actually download anything).
  platformDriveBackup Boolean @default(false)
  /// When this photo's platform-Drive-backup lifecycle actually began —
  /// the retention sweep's clock anchor, NOT createdAt (a direct upload can
  /// be backed up long after it was created; anchoring on createdAt would
  /// make it look instantly overdue). Set at capture time for a PandaShoots
  /// capture that goes straight to Drive, or at backup-existing run time
  /// otherwise. Null until platformDriveBackup is first set true.
  driveBackupStartedAt DateTime?

  /// How this photo arrived — "upload" (direct browser upload), "shoots"
  /// (PandaShoots FTP capture), or "drive_import". Set once at creation and
  /// never changed — storagePath/driveFileId get mutated by the retention
  /// sweeps over a photo's life, so they can't reliably answer "how did
  /// this arrive" later; this can. Powers the gallery's source filter.
  source String @default("upload")
  /// The platform-wide default-retention policy's clock (distinct from
  /// driveBackupStartedAt/platformDriveBackup above, which is Drive
  /// backup's own separate, stricter lifecycle) — see
  /// lib/photoRetention.js. Null for a photo with no local original to
  /// expire (a Drive import, or one already opted into Drive backup).
  /// Once past, the sweep deletes just the local file (storagePath -> null)
  /// and leaves the thumbnail/Face rows/Photo row alone — search keeps
  /// working forever, only the full-res download goes away.
  originalExpiresAt DateTime?

  /// "approved" (default, for every studio-side source) or "pending" (a
  /// guest upload awaiting the owner's review — see Event.guestUploadEnabled
  /// below). Never "rejected": a rejected guest upload is just deleted like
  /// any other unwanted photo, not kept in a rejected state. Pending photos
  /// are excluded from guest search and never trigger a live-gallery event
  /// until approved.
  approvalStatus String @default("approved")
  /// The anonymous guest_client_id (see guestId.js) that submitted this
  /// photo, only set for source: "guest". Not used for access control —
  /// just lets a future "your uploads" guest view exist without a schema
  /// change.
  uploadedByGuestClientId String?
  /// Best-effort auto-flag for a guest upload that might be inappropriate
  /// — a free, self-hosted heuristic (skin-exposure ratio via OpenCV in
  /// face-engine, not a trained ML classifier), so it's a "look at this
  /// one first" signal in the moderation queue, never an auto-reject.
  /// Always false for every non-guest source.
  moderationFlagged Boolean @default(false)

  /// Zero-copy feature membership for the unified Event model. The physical
  /// photo/file/Face rows exist once; these booleans decide which enabled
  /// feature surfaces can use the photo. A studio can include a photo in
  /// Face Search, Photo Selection, both, or neither without duplicating files.
  faceSearchVisible     Boolean @default(true)
  photoSelectionVisible Boolean @default(true)
  /// Phase 8: studio-starred for the live TV wall's highlights mode.
  highlighted         Boolean @default(false)
  /// Phase 9 (photography tools pack): sha256 of the file bytes for
  /// exact-duplicate detection (null until analyzed), Laplacian-variance
  /// sharpness (higher = sharper; null until analyzed/unmeasurable),
  /// EXIF snapshot (null when absent — e.g. screenshots, PNG exports),
  /// Lightroom-style color tag + 0-5 star rating.
  fileHash       String?
  sharpness      Float?
  exifCamera     String?
  exifLens       String?
  exifIso        Int?
  exifShutter    String?
  exifAperture   String?
  exifCapturedAt DateTime?
  colorTag       String?
  rating         Int      @default(0)

  /// Soft per-photo archive (mirrors Studio-Verse's media archive): an
  /// archived photo is hidden from guests (search/gallery/slideshow/
  /// downloads), clients (gallery/favourites/zips), and counts, while the
  /// studio keeps it visible with a restore action. Null = active.
  /// Distinct from permanent deletion, which removes rows and files.
  archivedAt DateTime?

  likes    PhotoLike[]
  comments PhotoComment[]

  /// MERGE (Studio-Verse Photo Selection): favourites this photo has
  /// received from logged-in clients / the studio's own separate picks.
  clientFavourites ClientFavourite[]
  studioFavourites StudioFavourite[]
  /// Album staging refs pointing at this photo (Phase 23, zero-cost).
  albumSources AlbumSource[]
}

/// MERGE (Studio-Verse Photo Selection): a pending invite for a client to
/// gain Photo Selection access to one event — mirrors EventInvite (staff
/// collaborator invites) exactly in shape, but accepting one creates an
/// EventUserMapping (+ a brand-new USER-role account if the email doesn't
/// have one yet) instead of an EventCollaborator. See routes/
/// clientInvites.js. favouriteCap is copied onto the EventUserMapping
/// created at accept time.
model ClientInvite {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  email        String
  token        String    @unique
  favouriteCap Int?
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?

  @@index([eventId])
  @@index([email])
}

/// MERGE (Studio-Verse tenant profile, Phase 18H): a studio's contact /
/// address details — the equivalent of Studio-Verse's tenant_name /
/// tenant_phone_number / tenant_studio_address columns. Kept as a 1:1
/// extension (rather than columns on User) so the identity row stays lean;
/// auto-created lazily on first profile read/write. All fields optional —
/// older accounts simply show name-only until the studio fills these in.
model TenantProfile {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  tenant       User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String?
  studioAddress String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// MERGE (Studio-Verse Photo Selection): grants a USER-role client access
/// to browse/favourite/submit on one event's gallery — the Photo
/// Selection equivalent of PandaSpot's EventCollaborator (which is a
/// studio-staff concept, not a client concept). One row per (event, user).
/// favouriteCap/submittedAt reproduce Studio-Verse's favourite-cap +
/// one-way submit-lock behavior exactly (see STUDIO_VERSE_HANDOFF.md).
model EventUserMapping {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  /// Null = no cap (unlimited favourites). Set by the studio per client.
  favouriteCap Int?
  /// Once set, this client's favourite selection is locked — matches
  /// Studio-Verse's one-way "submit" action (no un-submitting).
  submittedAt  DateTime?
  /// MERGE (Studio-Verse Access Board, Phase 18E): optional per-client
  /// gallery expiry — past this date the client's access reads as gone
  /// (see routes/client.js), without deleting the grant. Null = no expiry.
  accessExpires DateTime?
  /// Soft revoke — the studio's "remove now, maybe restore later". Revoked
  /// grants read as gone to the client but stay visible (with state) on
  /// the studio's Clients page and Access Board until hard-removed.
  revokedAt DateTime?

  @@unique([eventId, userId])
  @@index([userId])
}

/// MERGE (Studio-Verse resumable upload, Phase 18H): progress tracker for
/// one chunked large-file upload — the local-disk equivalent of
/// Studio-Verse's S3-multipart MediaUploadStage. Parts land in
/// storage/uploads/parts/<id>.part and are assembled on complete, after
/// which the file rejoins the regular async upload job (face detection,
/// thumbnailing, quota/storage checks), so a large file ends up a fully
/// normal Photo row. Status is one of "Uploading" | "Completed" | "Aborted".
model MediaUploadStage {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String   @default("application/octet-stream")
  totalBytes    Int      @default(0)
  receivedBytes Int      @default(0)
  status        String   @default("Uploading")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
}

/// MERGE (Studio-Verse Photo Selection): a client's favourite on one
/// photo. Distinct from PhotoLike (PandaSpot's anonymous-guest reaction
/// system, keyed by guestClientId) — this is a real logged-in User acting
/// within their granted EventUserMapping access.
model ClientFavourite {
  id        String   @id @default(uuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([photoId, userId])
  @@index([userId])
}

/// MERGE (Studio-Verse Photo Selection): the studio's own separate "picks"
/// on a client's event — kept as its own table (not reusing
/// ClientFavourite) because Studio-Verse treats studio picks and client
/// favourites as two independent lists over the same photo pool.
model StudioFavourite {
  id        String   @id @default(uuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([photoId, userId])
  @@index([userId])
}

/// A guest's reaction on a photo — one per (photo, guest); tapping a
/// different reaction type switches it, tapping the same one again
/// removes it. reactionType is one of REACTION_TYPES (see lib/reactions.js)
/// — stored as a plain string rather than a DB enum so adding a new
/// reaction type later never needs a migration. Public reaction counts are
/// an explicit product decision (not everyone wants this exposed): see
/// routes/guest.js's react endpoint.
model PhotoLike {
  id            String   @id @default(uuid())
  photoId       String
  photo         Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId       String
  guestClientId String
  reactionType  String   @default("heart")
  createdAt     DateTime @default(now())

  @@unique([photoId, guestClientId])
  @@index([eventId])
}

/// A guest comment on a photo — public to every guest browsing the event
/// (an explicit product decision, not a private feedback channel), so the
/// owner can delete an individual comment via the moderation UI.
model PhotoComment {
  id            String   @id @default(uuid())
  photoId       String
  photo         Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId       String
  guestClientId String
  guestName     String?
  text          String
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([photoId])
}

/// Face rows are inserted/queried via raw SQL because the `embedding` column
/// is an Unsupported pgvector type that Prisma Client cannot bind directly.
/// See lib/faces.js for the raw INSERT / SELECT helpers. The migration also
/// creates an HNSW index on `embedding` (Prisma's schema DSL can't express
/// pgvector index types itself, so it's hand-written SQL, not declared here).
model Face {
  id        String                  @id @default(uuid())
  photoId   String
  photo     Photo                   @relation(fields: [photoId], references: [id])
  eventId   String
  bbox      Json
  embedding Unsupported("vector(512)")
  detScore  Float
  createdAt DateTime                @default(now())

  @@index([eventId])
}

/// One row per guest selfie search — stores the (averaged, if multi-selfie)
/// query embedding so a later "not me" feedback report can be tied back to
/// it, and doubles as the analytics source (search counts, unique guests via
/// guestClientId, match rate). See lib/guestSearches.js for the raw
/// INSERT (embedding is Unsupported, same reason as Face.embedding).
model GuestSearch {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  embedding     Unsupported("vector(512)")
  facesDetected Int
  matchCount    Int
  guestClientId String?
  createdAt     DateTime @default(now())

  feedback MatchFeedback[]

  @@index([eventId])
}

/// A guest marking one match as "not me". Used to auto-nudge Event.matchThreshold
/// upward (see lib/threshold.js) and as an analytics signal.
model MatchFeedback {
  id         String      @id @default(uuid())
  searchId   String
  search     GuestSearch @relation(fields: [searchId], references: [id])
  photoId    String
  similarity Float
  createdAt  DateTime    @default(now())

  @@index([searchId])
}

/// A pre-built zip, generated asynchronously and emailed to a guest as a
/// download link instead of blocking their browser tab on a large selection.
/// A guest opting in to be notified (email or WhatsApp) if more photos of
/// them show up later in the same event — the natural follow-up once photos
/// can keep arriving live via PandaShoots after their first search. One row per
/// (event, guestClientId): a guest who searches again just updates their
/// existing subscription rather than creating a second one. See
/// lib/guestAlerts.js for the matching/notify job.
model GuestAlertSubscription {
  id             String    @id @default(uuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  guestClientId  String
  /// "email" | "whatsapp"
  channel        String
  /// An email address or E.164 phone number, depending on channel.
  contact        String
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?
  active         Boolean   @default(true)

  @@unique([eventId, guestClientId])
  @@index([eventId])
}

model ZipDownload {
  id           String    @id @default(uuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id])
  photoIds     Json
  email        String?
  status       String    @default("pending") // pending | ready | failed
  filePath     String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  readyAt      DateTime?

  @@index([eventId])
}

// =====================================================================
// MERGE (Studio-Verse Billing & Subscriptions) — Phase 12. Ported field-
// for-field from Studio-Verse's schema (see MERGE_PLAN.md for the full
// business-rule extraction this was based on), renamed to this project's
// camelCase convention. "Tenant" in Studio-Verse's language is just an
// ADMIN-role User here — there's no separate Tenant table in the unified
// model, so every `tenantId` below is a plain FK to User.id. No real
// payment gateway is ported (Studio-Verse never had one either — see
// PaymentMethod: payments are recorded, not gatewayed).
// =====================================================================

enum PlanType {
  SUBSCRIPTION
  WALLET
}

enum DurationUnit {
  DAYS
  MONTHS
  YEARS
}

enum WalletTier {
  INITIAL
  TOPUP
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  CONFIRMED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  GPAY
  CARD
  BANK_TRANSFER
  CHEQUE
}

model SubscriptionPlan {
  id                       String       @id @default(uuid())
  planName                 String
  planType                 PlanType
  /// SUBSCRIPTION only.
  durationValue            Int?
  durationUnit             DurationUnit?
  photoQuota               Int?
  price                    Decimal      @db.Decimal(10, 2)
  /// WALLET only — credits granted on purchase.
  walletCredits            Int?
  walletTier               WalletTier?
  /// WALLET only — credits deducted per AI-matched photo.
  aiCreditCostPerPhoto     Int?
  /// SUBSCRIPTION only — whether events on this plan get Face Search.
  includesAiMedia          Boolean      @default(false)
  /// Grandfathering: only tenants created before this date can see/pick
  /// this plan — lets a plan be retired without breaking existing subs.
  specialAccessCutoffDate  DateTime?
  displayOrder             Int          @default(0)
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  subscriptions TenantSubscription[]
}

/// MERGE: one row per subscription period/state change for a tenant — see
/// lib/subscriptionAccess.js for the lazy lifecycle sweep
/// (TRIAL/ACTIVE → GRACE → EXPIRED) this model drives. The partial unique
/// index below (hand-added to the migration, Prisma's schema DSL can't
/// express a `WHERE` clause) is the same "exactly one active row" pattern
/// proven in Studio-Verse — enforced at the DB level, not just in code.
model TenantSubscription {
  id                 String                    @id @default(uuid())
  tenantId           String
  tenant             User                      @relation(fields: [tenantId], references: [id])
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan?         @relation(fields: [subscriptionPlanId], references: [id])
  status             TenantSubscriptionStatus
  /// Free-text, matching Studio-Verse exactly (not an enum there either):
  /// SUBSCRIBE | UPGRADE | DOWNGRADE | TRIAL | FREE_GRANT | ADMIN_SET.
  changeType         String?
  lockedPrice        Decimal?                  @db.Decimal(10, 2)
  isPriceLocked      Boolean                   @default(false)
  isFreeGrant        Boolean                   @default(false)
  photoQuotaTotal    Int
  photoQuotaUsed     Int                       @default(0)
  startsAt           DateTime                  @default(now())
  expiresAt          DateTime?
  graceEndsAt        DateTime?
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([tenantId])
}

model TenantWallet {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         User     @relation(fields: [tenantId], references: [id])
  balanceCredits Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// MERGE: the wallet ledger — every RECHARGE/AI_USAGE/ADJUSTMENT gets a
/// row here, each carrying the resulting balanceAfter for point-in-time
/// reconstruction (see lib/subscriptionAccess.js).
model WalletTransaction {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       User     @relation(fields: [tenantId], references: [id])
  /// RECHARGE | AI_USAGE | ADJUSTMENT
  type         String
  /// Signed — negative for usage/deductions.
  credits      Int
  balanceAfter Int
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

/// MERGE: platform-wide trial/grace defaults, Super-Admin-tunable at
/// runtime (mirrors the DEFAULT_TRIAL_*/DEFAULT_*_GRACE_DAYS env vars
/// already in .env.example, which now only seed this row on first boot —
/// see lib/subscriptionAccess.js). Singleton: always id "singleton".
model PlatformSettings {
  id                 String   @id @default("singleton")
  trialDurationDays  Int      @default(7)
  trialPhotoQuota    Int      @default(200)
  monthlyGraceDays   Int      @default(3)
  yearlyGraceDays    Int      @default(12)
  /// Platform launch switch: while true, every studio can keep using all
  /// upload/import/Shoots paths even though quota lifecycle code is wired.
  /// Super Admin can turn this off later to enforce paid/trial plans.
  freeAccessEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// MERGE: per-tenant atomic document-numbering counters (see
/// lib/billingAccess.js's claimNextNumber — an upsert-with-increment
/// inside the same transaction that creates the document, ported
/// verbatim from Studio-Verse) plus display-only GST fields.
model TenantBillingSettings {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  tenant                User     @relation(fields: [tenantId], references: [id])
  nextQuotationNumber   Int      @default(1)
  nextBillNumber        Int      @default(1)
  nextReceiptNumber     Int      @default(1)
  gstinNumber           String?
  gstState              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StudioService {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
  name      String
  price     Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// MERGE: `clientId` is a real USER-role `User` — this merge has no
/// separate legacy BillingClient table (Studio-Verse's own is explicitly
/// dead/superseded — see MERGE_PLAN.md). quotationNumber is unique per
/// tenant (not globally), claimed atomically via TenantBillingSettings.
model Quotation {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          User            @relation("QuotationTenant", fields: [tenantId], references: [id])
  clientId        String
  client          User            @relation("QuotationClient", fields: [clientId], references: [id])
  quotationNumber Int
  status          QuotationStatus @default(DRAFT)
  /// Flat, whole-document discount — see lib/billingAccess.js's payable
  /// calculation. Independent of each item's own discountPerUnit.
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items QuotationItem[]
  bill  Bill?

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([clientId])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal   @db.Decimal(10, 2)
  quantity        Int
  /// Flat, per-unit discount — see Quotation.discountAmount's comment.
  discountPerUnit Decimal   @default(0) @db.Decimal(10, 2)
  /// Insertion order for PDF rendering (Phase 21 fix: the PDF routes
  /// order items by createdAt, which didn't exist — every PDF download
  /// crashed with a Prisma validation error).
  createdAt       DateTime  @default(now())
}

/// MERGE: can ONLY be created from a confirmed Quotation (see
/// routes/billing.js's confirm endpoint — enforced in application code,
/// same as Studio-Verse: there is deliberately no create-Bill-directly
/// route). Immutable once created: deliberately no update endpoint,
/// matching Studio-Verse's approach exactly (enforced by the absence of
/// a mutation route, not a DB trigger).
model Bill {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         User       @relation("BillTenant", fields: [tenantId], references: [id])
  clientId       String
  client         User       @relation("BillClient", fields: [clientId], references: [id])
  quotationId    String     @unique
  quotation      Quotation  @relation(fields: [quotationId], references: [id])
  billNumber     Int
  status         BillStatus @default(UNPAID)
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items    BillItem[]
  payments Payment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([clientId])
}

model BillItem {
  id              String  @id @default(uuid())
  billId          String
  bill            Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal @db.Decimal(10, 2)
  quantity        Int
  discountPerUnit Decimal @default(0) @db.Decimal(10, 2)
  /// Insertion order for PDF rendering — see QuotationItem.createdAt.
  createdAt       DateTime @default(now())
}

/// MERGE: partial/split payments against one Bill — see
/// routes/billing.js's overpayment guard (a 0.01 epsilon absorbs
/// Decimal/float rounding, matching Studio-Verse exactly).
model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        User          @relation("PaymentTenant", fields: [tenantId], references: [id])
  billId        String
  bill          Bill          @relation(fields: [billId], references: [id])
  receiptNumber Int
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  remark        String?
  createdAt     DateTime      @default(now())

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([billId])
}

// =====================================================================
// MERGE (Studio-Verse Support Tickets) — Phase 13.
// =====================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// MERGE: tenantId is the studio/admin responsible for the ticket. requesterId
/// is the logged-in user who raised it. ADMIN/INVITED support goes straight to
/// SUPER_ADMIN only by using requesterId=tenantId; USER/client support is
/// routed to the owning studio via tenantId and remains visible to both that
/// studio admin and SUPER_ADMIN.
model SupportTicket {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      User                @relation("SupportTicketTenant", fields: [tenantId], references: [id])
  requesterId String
  requester   User                @relation("SupportTicketRequester", fields: [requesterId], references: [id])
  eventId     String?
  event       Event?              @relation(fields: [eventId], references: [id])
  subject     String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  replies SupportTicketReply[]

  @@index([tenantId])
  @@index([requesterId])
  @@index([eventId])
}

model SupportTicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// =====================================================================
// ALBUM PROOFING (Phase 23)
// =====================================================================

/// Album proofing review lifecycle (studio-designed spreads reviewed by
/// the client): DRAFT (studio working, invisible to clients) -> SENT
/// (under client review) -> CHANGES_REQUESTED (client asked for a new
/// round) -> SENT (each new version re-sends automatically) ->
/// APPROVED (client signed off; lockedAt set, everything frozen until
/// the studio reopens back to DRAFT).
enum AlbumStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  APPROVED
}

/// One album project inside an event (e.g. "Wedding Album"). The flow:
/// studio stages source photos (zero-cost refs to Photo rows) ->
/// downloads full-res -> designs spreads externally -> uploads spread
/// images (or a print PDF) as a version -> client reviews, pins
/// comments, requests changes or approves. Files live under
/// storage/events/<id>/albums/ so event cascade-delete removes them.
model Album {
  id        String      @id @default(uuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  status    AlbumStatus @default(DRAFT)
  lockedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  /// Phase 4: who created the project (SetNull — the album survives its
  /// creator) and when it was last sent for review. Null on pre-Phase-4 rows.
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentAt      DateTime?

  sources  AlbumSource[]
  versions AlbumVersion[]

  @@index([eventId])
}

/// Zero-cost staging refs from photo-selection favourites (or any event
/// photos) into an album — points at the same Photo row, no file copy.
/// The studio downloads these full-res originals to design spreads from.
model AlbumSource {
  id        String   @id @default(uuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([albumId, photoId])
  @@index([albumId])
}

/// One revision round (Version 1, 2, Final…). Either spread images
/// (ordered pages for the flipbook) or a single print PDF — never both.
model AlbumVersion {
  id            String   @id @default(uuid())
  albumId       String
  album         Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  versionNumber Int
  note          String?
  /// Print-ready file for download (optional, images still drive review).
  printPdfPath  String?
  createdAt     DateTime @default(now())

  pages    AlbumPage[]
  comments AlbumComment[]

  @@unique([albumId, versionNumber])
  @@index([albumId])
}

/// One spread/page image inside a version, ordered for the flipbook.
model AlbumPage {
  id           String       @id @default(uuid())
  versionId    String
  version      AlbumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageNumber   Int
  storagePath  String
  thumbnailPath String?
  filename     String
  fileSize     Int          @default(0)
  /// Phase 4: spread pixel dimensions when detectable at upload
  /// (sharp metadata; null for PDFs/unreadable files).
  width        Int?
  height       Int?
  createdAt    DateTime     @default(now())

  comments AlbumComment[]

  @@unique([versionId, pageNumber])
  @@index([versionId])
}

/// Pinned revision feedback on a version: top-level pins carry an
/// optional page + 0-100 position (numbered per version+page) or act as
/// general version notes when positionless; replies thread under a
/// parent pin. Resolution is studio-side. Frozen once the album is
/// APPROVED (no new pins/replies then).
model AlbumComment {
  id         String       @id @default(uuid())
  versionId  String
  version    AlbumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageId     String?
  page       AlbumPage?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     AlbumComment?  @relation("AlbumCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    AlbumComment[] @relation("AlbumCommentThread")
  /// Display number within its version+page (top-level positioned pins
  /// only; replies and general notes carry null).
  pinNumber  Int?
  xPct       Float?
  yPct       Float?
  message    String
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([versionId])
  @@index([pageId])
  @@index([parentId])
}

/// Phase 2 (consent-first Face Search): proof that a guest accepted the
/// selfie-search terms before matching ran. One row per accepted search
/// (cheap, append-only audit). Kept even by the retention sweep — it's
/// the legal record that processing was allowed, not biometric data.
model GuestConsent {
  id             String   @id @default(uuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestClientId  String
  consentedAt    DateTime @default(now())
  consentText    String
  consentVersion String   @default("v1")
  ip             String?
  userAgent      String?

  @@index([eventId])
  @@index([guestClientId])
}

/// Phase 2: a guest's export/delete request for their own Face Search
/// data (searches, alerts, reactions, comments), filed from the event
/// page with their guest id + optional contact. Platform admins review
/// and complete them (delete erases the guest's rows).
model GuestDataRequest {
  id            String    @id @default(uuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestClientId String
  contact       String?
  /// "export" | "delete"
  type          String
  /// "pending" | "completed" | "rejected"
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([eventId, status])
  @@index([guestClientId])
}
