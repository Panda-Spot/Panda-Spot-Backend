# Postgres connection string (must point to a DB with the pgvector extension available)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pandaspot?schema=public"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Base URL of the face-engine Python microservice
FACE_ENGINE_URL="http://127.0.0.1:8001"

# Directory (relative or absolute) where uploaded photos are stored on disk
STORAGE_DIR="./storage"

# Cosine-similarity cutoff for a guest selfie to count as a match (0-1)
FACE_MATCH_THRESHOLD="0.36"

# Port the API server listens on
PORT="4000"

# Origin of the frontend app (required for cookie-based auth with CORS)
CORS_ORIGIN="http://localhost:5173"

# SMTP settings for emailing guests their zip download link (Feature 7).
# Left unset, the server just logs the link instead of sending an email —
# safe no-op until real credentials are wired in.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PandaSpot <no-reply@pandaspot.example>"

# This server's own public base URL, used to build the emailed zip download
# link (must be reachable by the guest's browser/email client).
PUBLIC_SERVER_URL="http://localhost:4000"

# The frontend web app's public base URL, used to build collaborator invite
# links (e.g. ${PUBLIC_WEB_URL}/invites/:token) emailed to invited second
# shooters/assistants.
PUBLIC_WEB_URL="http://localhost:5173"

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
# for "Sign in with Google". Left unset, POST /auth/google cleanly responds
# 503 instead of crashing — set this once you've created a real Client ID.
GOOGLE_CLIENT_ID=""

# Comma-separated allowlist of email addresses allowed to hit /admin/* routes
# (platform-operator view — total users/events/photos/storage/searches, not a
# general role system). e.g. "you@example.com,teammate@example.com"
ADMIN_EMAILS=""

# Google Drive API key (Google Cloud Console > APIs & Services > Credentials
# > API key, with the Google Drive API enabled) — used ONLY for the "import
# an event's photos from a public Google Drive folder" feature. This is a
# separate credential from GOOGLE_CLIENT_ID above (that one is for "Sign in
# with Google" OAuth; this one is a plain API key for read-only Drive API v3
# calls against public folders). Left unset, POST /events/:id/import/drive
# cleanly responds 400 with an "isn't configured yet" error instead of
# crashing — set this once you've created a real API key.
GOOGLE_DRIVE_API_KEY=""

# --- Beam: camera-to-cloud live upload (see lib/ftpBeam.js) ---
# An FTP server the photographer's own camera connects to directly (native
# in-camera FTP transfer, the same mechanism press/wedding photographers
# already use — no companion app or extra hardware needed). Each event gets
# its own generated username/password (see /events/:id/beam/credentials);
# a per-connection root keeps one event's session confined to just its own
# incoming folder.

# Port the Beam FTP server listens on. Use a non-privileged port (>1024) so
# the Node process doesn't need root — cameras have an explicit "Port" field
# in their FTP transfer settings, so a non-default port is fine.
FTP_PORT="2121"

# Passive-mode data port range — must be opened on the VPS firewall/NAT
# alongside FTP_PORT itself, or camera uploads will hang after login. Keep
# this range modest; each active camera connection only needs one port at a
# time.
FTP_PASV_MIN="30100"
FTP_PASV_MAX="30110"

# The VPS's public IP or hostname — required for passive-mode transfers to
# work through NAT (without it, the server would tell the camera to connect
# back to its own private/internal address, which fails). Leave unset only
# for local testing; camera uploads over the internet need this set.
FTP_PUBLIC_HOST=""

# Optional TLS cert/key paths to run Beam as FTPS instead of plain FTP.
# Strongly recommended for real events (plain FTP sends the event's
# username/password unencrypted) — left unset, Beam runs without TLS and
# logs a warning on startup.
FTP_TLS_CERT_PATH=""
FTP_TLS_KEY_PATH=""
